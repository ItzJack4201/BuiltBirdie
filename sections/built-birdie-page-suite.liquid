    {
      "type": "collection_callout",
      "name": "Collection callout",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Build Your Bag"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
