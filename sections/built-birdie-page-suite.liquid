    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Cream",
      "default": "#f7f1e7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "muted_color",
