          "default": "System"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Built to match"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Choose a base, pick an accent, and keep the setup cohesive."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    },
    {
      "type": "stat_card",
      "name": "Stat card",
      "settings": [
        {
          "type": "text",
