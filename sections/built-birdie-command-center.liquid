{% style %}
  #BuiltBirdieCommandCenter-{{ section.id }} {
    --bbcc-bg: {{ section.settings.background_color }};
    --bbcc-panel: {{ section.settings.panel_color }};
    --bbcc-cream: {{ section.settings.cream_color }};
    --bbcc-text: {{ section.settings.text_color }};
    --bbcc-muted: {{ section.settings.muted_color }};
    --bbcc-green: {{ section.settings.accent_green }};
    --bbcc-red: {{ section.settings.accent_red }};
    --bbcc-border: rgba(255, 255, 255, 0.14);
  }
{% endstyle %}

<section id="BuiltBirdieCommandCenter-{{ section.id }}" class="built-birdie-command-center" data-bb-command-center>
  <div class="built-birdie-command-center__inner">
    <div class="built-birdie-command-center__head">
      <div>
        <p class="built-birdie-command-center__eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
      </div>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="built-birdie-command-center__console">
      <div class="built-birdie-command-center__readout" aria-live="polite">
        <span>{{ section.settings.readout_label }}</span>
        <strong data-bbcc-count>{{ section.blocks.size }}</strong>
      </div>
      <div class="built-birdie-command-center__filters" aria-label="{{ section.settings.filter_label | escape }}">
        <button type="button" data-bbcc-filter="all" aria-pressed="true">{{ section.settings.all_label }}</button>
        <button type="button" data-bbcc-filter="build">{{ section.settings.build_label }}</button>
        <button type="button" data-bbcc-filter="color">{{ section.settings.color_label }}</button>
        <button type="button" data-bbcc-filter="kit">{{ section.settings.kit_label }}</button>
        <button type="button" data-bbcc-filter="gift">{{ section.settings.gift_label }}</button>
        <button type="button" data-bbcc-filter="support">{{ section.settings.support_label }}</button>
      </div>
    </div>

    <div class="built-birdie-command-center__grid">
      {% for block in section.blocks %}
        <a class="built-birdie-command-center__card" href="{{ block.settings.link }}" data-bbcc-card data-bbcc-group="{{ block.settings.group }}" {{ block.shopify_attributes }}>
          <span>{{ block.settings.kicker }}</span>
          <strong>{{ block.settings.title }}</strong>
          <p>{{ block.settings.text }}</p>
          <small>{{ block.settings.signal }}</small>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .built-birdie-command-center {
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      var(--bbcc-bg);
    background-size: 36px 36px, 36px 36px, auto;
    color: var(--bbcc-text);
    padding: clamp(42px, 7vw, 96px) clamp(16px, 4vw, 56px);
  }

  .built-birdie-command-center * {
    box-sizing: border-box;
  }

  .built-birdie-command-center__inner {
    margin-inline: auto;
    max-width: 1180px;
  }

  .built-birdie-command-center__head {
    align-items: end;
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(0, 0.72fr) minmax(280px, 0.42fr);
    margin-block-end: 18px;
  }

  .built-birdie-command-center__eyebrow,
  .built-birdie-command-center__card span {
    color: var(--bbcc-red);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .built-birdie-command-center h1,
  .built-birdie-command-center p {
    margin-block-start: 0;
  }

  .built-birdie-command-center h1 {
    font-size: clamp(3rem, 7.8vw, 7rem);
    font-weight: 930;
    letter-spacing: 0;
    line-height: 0.88;
    margin-block-end: 0;
  }

  .built-birdie-command-center__head > p,
  .built-birdie-command-center__card p {
    color: var(--bbcc-muted);
    line-height: 1.55;
    margin-block-end: 0;
  }

  .built-birdie-command-center__console {
    align-items: center;
    background: color-mix(in srgb, var(--bbcc-panel) 88%, transparent);
    border: 1px solid var(--bbcc-border);
    border-radius: 8px;
    display: grid;
    gap: 14px;
    grid-template-columns: minmax(150px, 0.22fr) minmax(0, 1fr);
    margin-block-end: 14px;
    padding: 14px;
  }

  .built-birdie-command-center__readout {
    border: 1px solid var(--bbcc-border);
    border-radius: 8px;
    display: grid;
    gap: 6px;
    padding: 12px;
  }

  .built-birdie-command-center__readout span {
    color: var(--bbcc-muted);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .built-birdie-command-center__readout strong {
    font-size: 1.55rem;
    line-height: 1;
  }

  .built-birdie-command-center__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .built-birdie-command-center__filters button {
    background: transparent;
    border: 1px solid var(--bbcc-border);
    border-radius: 999px;
    color: var(--bbcc-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 850;
    min-height: 42px;
    padding: 9px 14px;
  }

  .built-birdie-command-center__filters button[aria-pressed="true"] {
    background: var(--bbcc-text);
    color: var(--bbcc-bg);
  }

  .built-birdie-command-center__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .built-birdie-command-center__card {
    background: color-mix(in srgb, var(--bbcc-panel) 88%, transparent);
    border: 1px solid var(--bbcc-border);
    border-radius: 8px;
    color: var(--bbcc-text);
    display: grid;
    gap: 12px;
    min-height: 220px;
    padding: 18px;
    text-decoration: none;
  }

  .built-birdie-command-center__card[hidden] {
    display: none;
  }

  .built-birdie-command-center__card strong {
    display: block;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1;
  }

  .built-birdie-command-center__card small {
    align-self: end;
    border-block-start: 1px solid var(--bbcc-border);
    color: var(--bbcc-green);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    padding-block-start: 12px;
    text-transform: uppercase;
  }

  @media screen and (max-width: 1180px) {
    .built-birdie-command-center__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 989px) {
    .built-birdie-command-center__head,
    .built-birdie-command-center__console {
      grid-template-columns: 1fr;
    }

    .built-birdie-command-center__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .built-birdie-command-center {
      padding: 36px 16px 48px;
    }

    .built-birdie-command-center__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-bb-command-center]').forEach((center) => {
    const buttons = Array.from(center.querySelectorAll('[data-bbcc-filter]'));
    const cards = Array.from(center.querySelectorAll('[data-bbcc-card]'));
    const count = center.querySelector('[data-bbcc-count]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const group = button.dataset.bbccFilter;
        let visible = 0;

        buttons.forEach((item) => {
          item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
        });

        cards.forEach((card) => {
          const show = group === 'all' || card.dataset.bbccGroup === group;
          card.hidden = !show;
          if (show) {
            visible += 1;
          }
        });

        count.textContent = visible;
      });
    });
  });
{% endjavascript %}

