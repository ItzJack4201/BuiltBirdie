{% liquid
  assign bag_colors = section.settings.bag_colors | split: ','
  assign accent_colors = section.settings.accent_colors | split: ','
  assign fallback_collection_url = routes.collections_url | append: '/build-your-bag'
%}

{% capture fallback_url %}
  {% render 'built-birdie-safe-link', link: fallback_collection_url, fallback: routes.collections_url %}
{% endcapture %}

{% style %}
  #BuiltBirdieConfiguratorV2-{{ section.id }} {
    --bbv2-bg: {{ section.settings.background_color }};
    --bbv2-cream: {{ section.settings.cream_color }};
    --bbv2-panel: {{ section.settings.panel_color }};
    --bbv2-text: {{ section.settings.text_color }};
    --bbv2-muted: {{ section.settings.muted_color }};
    --bbv2-green: {{ section.settings.accent_green }};
    --bbv2-red: {{ section.settings.accent_red }};
    --bbv2-border: rgba(17, 17, 17, 0.12);
  }
{% endstyle %}

<section
  id="BuiltBirdieConfiguratorV2-{{ section.id }}"
  class="built-birdie-configurator-v2"
  data-bbv2-configurator
  data-bbv2-empty-message="{{ section.settings.empty_message | escape }}"
  data-bbv2-empty-strip-label="{{ section.settings.empty_strip_label | escape }}"
  data-bbv2-coming-soon-label="{{ section.settings.coming_soon_label | escape }}"
  data-bbv2-loading-message="{{ section.settings.loading_message | escape }}"
  data-bbv2-error-message="{{ section.settings.error_message | escape }}"
>
  <div class="built-birdie-configurator-v2__shell">
    <div class="built-birdie-configurator-v2__support-map" hidden>
      {% for block in section.blocks %}
        {% if block.type == 'supported_build' %}
          <span
            data-bbv2-build
            data-bag="{{ block.settings.bag_color }}"
            data-accent="{{ block.settings.accent_color }}"
            data-style="{{ block.settings.style_group }}"
            data-supported="{{ block.settings.is_supported }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.title }}
          </span>
        {% endif %}
      {% endfor %}
    </div>

    <header class="built-birdie-configurator-v2__intro">
      <p class="built-birdie-configurator-v2__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </header>

    <div class="built-birdie-configurator-v2__layout">
      <aside class="built-birdie-configurator-v2__controls" aria-label="{{ section.settings.controls_label | escape }}">
        <fieldset>
          <legend>{{ section.settings.bag_label }}</legend>
          <div class="built-birdie-configurator-v2__option-grid">
            {% for color in bag_colors %}
              {% liquid
                assign color_label = color | strip
                assign color_handle = color_label | handleize
              %}
              <label class="built-birdie-configurator-v2__swatch built-birdie-configurator-v2__swatch--{{ color_handle }}" data-bbv2-option="bag" data-bbv2-option-value="{{ color_handle }}">
                <input type="radio" name="bbv2-bag-{{ section.id }}" value="{{ color_handle }}" data-bbv2-choice="bag" {% if forloop.first %}checked{% endif %}>
                <span>{{ color_label }}</span>
                <small>{{ section.settings.coming_soon_label }}</small>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        <fieldset>
          <legend>{{ section.settings.accent_label }}</legend>
          <div class="built-birdie-configurator-v2__option-grid">
            {% for color in accent_colors %}
              {% liquid
                assign color_label = color | strip
                assign color_handle = color_label | handleize
              %}
              <label class="built-birdie-configurator-v2__swatch built-birdie-configurator-v2__swatch--{{ color_handle }}" data-bbv2-option="accent" data-bbv2-option-value="{{ color_handle }}">
                <input type="radio" name="bbv2-accent-{{ section.id }}" value="{{ color_handle }}" data-bbv2-choice="accent" {% if forloop.first %}checked{% endif %}>
                <span>{{ color_label }}</span>
                <small>{{ section.settings.coming_soon_label }}</small>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        <fieldset>
          <legend>{{ section.settings.style_label }}</legend>
          <div class="built-birdie-configurator-v2__styles">
            {% assign first_style_checked = false %}
            {% for block in section.blocks %}
              {% if block.type == 'style_card' %}
                <label class="built-birdie-configurator-v2__style" data-bbv2-option="style" data-bbv2-option-value="{{ block.settings.style_key }}" {{ block.shopify_attributes }}>
                  <input
                    type="radio"
                    name="bbv2-style-{{ section.id }}"
                    value="{{ block.settings.style_key }}"
                    data-bbv2-choice="style"
                    data-bbv2-style-title="{{ block.settings.title | escape }}"
                    data-bbv2-style-note="{{ block.settings.cart_note | escape }}"
                    {% unless first_style_checked %}checked{% endunless %}
                  >
                  <span>{{ block.settings.title }}</span>
                  <small>{{ block.settings.description }}</small>
                  <b>{{ section.settings.coming_soon_label }}</b>
                </label>
                {% assign first_style_checked = true %}
              {% endif %}
            {% endfor %}
          </div>
        </fieldset>
      </aside>

      <div class="built-birdie-configurator-v2__stage-wrap">
        <div class="built-birdie-configurator-v2__stage" aria-label="{{ section.settings.stage_label | escape }}">
          <div class="built-birdie-configurator-v2__stage-top">
            <span>{{ section.settings.stage_kicker }}</span>
            <strong data-bbv2-stage-title>{{ section.settings.stage_title }}</strong>
          </div>

          <div class="built-birdie-configurator-v2__visual" aria-hidden="true" data-bbv2-stage>
            <div class="built-birdie-configurator-v2__palette">
              <span>
                <i data-bbv2-base-chip></i>
                <b data-bbv2-base-label>Black base</b>
              </span>
              <span>
                <i data-bbv2-accent-chip></i>
                <b data-bbv2-accent-label>Black accent</b>
              </span>
            </div>

            <div class="built-birdie-configurator-v2__bag">
              <i></i>
              <span></span>
              <b></b>
              <em></em>
            </div>

            {% for block in section.blocks %}
              {% if block.type == 'product_slot' %}
                {% liquid
                  assign slot_product = block.settings.product
                  assign slot_variant = blank
                  assign slot_price = 0
                  assign slot_available = false
                  assign slot_supported = true
                  if block.settings.is_supported == false
                    assign slot_supported = false
                  endif

                  if slot_product != blank
                    assign slot_variant = slot_product.selected_or_first_available_variant
                    assign slot_price = slot_variant.price
                    assign slot_available = slot_variant.available
                  endif
                %}
                <article
                  class="built-birdie-configurator-v2__accessory built-birdie-configurator-v2__accessory--{{ block.settings.stage_position }}"
                  data-bbv2-product
                  data-bag="{{ block.settings.bag_color }}"
                  data-accent="{{ block.settings.accent_color }}"
                  data-style="{{ block.settings.style_group }}"
                  data-role="{{ block.settings.role | escape }}"
                  data-title="{% if slot_product != blank %}{{ slot_product.title | escape }}{% else %}{{ block.settings.placeholder_title | escape }}{% endif %}"
                  data-price="{{ slot_price }}"
                  data-variant-id="{% if slot_variant != blank %}{{ slot_variant.id }}{% endif %}"
                  data-available="{{ slot_available }}"
                  data-supported="{{ slot_supported }}"
                  data-product-assigned="{% if slot_product != blank %}true{% else %}false{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <div class="built-birdie-configurator-v2__accessory-media">
                    {% if slot_product.featured_image != blank %}
                      {{ slot_product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', class: 'built-birdie-configurator-v2__accessory-image', alt: slot_product.title }}
                    {% else %}
                      <span>{{ block.settings.fallback_initials }}</span>
                    {% endif %}
                  </div>
                  <p>{{ block.settings.role }}</p>
                </article>
              {% endif %}
            {% endfor %}
          </div>

          <div class="built-birdie-configurator-v2__included-strip" aria-live="polite">
            <span>{{ section.settings.included_label }}</span>
            <strong data-bbv2-included-strip>{{ section.settings.empty_strip_label }}</strong>
          </div>
        </div>
      </div>

      <aside class="built-birdie-configurator-v2__summary" aria-live="polite">
        <p class="built-birdie-configurator-v2__eyebrow">{{ section.settings.summary_eyebrow }}</p>
        <h2 data-bbv2-build-name>{{ section.settings.summary_heading }}</h2>
        <p data-bbv2-why>{{ section.settings.default_kit_note }}</p>

        <div class="built-birdie-configurator-v2__summary-block">
          <span>{{ section.settings.selected_label }}</span>
          <strong data-bbv2-selection>{{ section.settings.default_selection }}</strong>
        </div>

        <div class="built-birdie-configurator-v2__items">
          <span>{{ section.settings.included_label }}</span>
          <ul data-bbv2-items></ul>
        </div>

        <div class="built-birdie-configurator-v2__total">
          <span>{{ section.settings.total_label }}</span>
          <strong data-bbv2-total>{{ 0 | money }}</strong>
        </div>

        <button type="button" class="built-birdie-configurator-v2__button" data-bbv2-add>
          {{ section.settings.add_button_label }}
        </button>
        <a class="built-birdie-configurator-v2__fallback" href="{{ fallback_url | strip }}">
          {{ section.settings.fallback_label }}
        </a>
        <p class="built-birdie-configurator-v2__message" data-bbv2-message></p>
      </aside>
    </div>

    <div class="built-birdie-configurator-v2__product-dock">
      <div>
        <p class="built-birdie-configurator-v2__eyebrow">{{ section.settings.dock_eyebrow }}</p>
        <h2>{{ section.settings.dock_heading }}</h2>
      </div>
      <div class="built-birdie-configurator-v2__dock-grid" data-bbv2-dock></div>
    </div>
  </div>
</section>

{% stylesheet %}
  .built-birdie-configurator-v2 {
    background:
      linear-gradient(90deg, rgba(15, 63, 46, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, rgba(15, 63, 46, 0.045) 1px, transparent 1px),
      linear-gradient(180deg, var(--bbv2-cream), var(--bbv2-bg) 28%);
    background-size: 46px 46px, 46px 46px, auto;
    color: var(--bbv2-text);
    padding: clamp(42px, 7vw, 96px) clamp(16px, 4vw, 56px);
  }

  .built-birdie-configurator-v2 * {
    box-sizing: border-box;
  }

  .built-birdie-configurator-v2__shell {
    margin-inline: auto;
    max-width: 1320px;
  }

  .built-birdie-configurator-v2__intro {
    margin-block-end: clamp(28px, 5vw, 56px);
    max-width: 900px;
  }

  .built-birdie-configurator-v2__eyebrow {
    color: var(--bbv2-green);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .built-birdie-configurator-v2 h1,
  .built-birdie-configurator-v2 h2,
  .built-birdie-configurator-v2 p {
    margin-block-start: 0;
  }

  .built-birdie-configurator-v2 h1 {
    font-size: clamp(3.4rem, 8.8vw, 8.4rem);
    font-weight: 930;
    letter-spacing: 0;
    line-height: 0.88;
    margin-block-end: 22px;
  }

  .built-birdie-configurator-v2__intro > p,
  .built-birdie-configurator-v2__summary > p,
  .built-birdie-configurator-v2__style small,
  .built-birdie-configurator-v2__message {
    color: var(--bbv2-muted);
    line-height: 1.55;
  }

  .built-birdie-configurator-v2__layout {
    align-items: stretch;
    display: grid;
    gap: 14px;
    grid-template-columns: minmax(260px, 0.24fr) minmax(420px, 1fr) minmax(300px, 0.3fr);
  }

  .built-birdie-configurator-v2__controls,
  .built-birdie-configurator-v2__stage,
  .built-birdie-configurator-v2__summary,
  .built-birdie-configurator-v2__product-dock {
    background: color-mix(in srgb, var(--bbv2-panel) 90%, transparent);
    border: 1px solid var(--bbv2-border);
    border-radius: 8px;
  }

  .built-birdie-configurator-v2__controls,
  .built-birdie-configurator-v2__summary {
    padding: clamp(18px, 2.5vw, 26px);
  }

  .built-birdie-configurator-v2 fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .built-birdie-configurator-v2 fieldset + fieldset {
    border-block-start: 1px solid var(--bbv2-border);
    margin-block-start: 22px;
    padding-block-start: 22px;
  }

  .built-birdie-configurator-v2 legend {
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    margin-block-end: 12px;
    text-transform: uppercase;
  }

  .built-birdie-configurator-v2__option-grid {
    display: grid;
    gap: 9px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .built-birdie-configurator-v2__swatch,
  .built-birdie-configurator-v2__style {
    border: 1px solid var(--bbv2-border);
    border-radius: 8px;
    cursor: pointer;
    position: relative;
  }

  .built-birdie-configurator-v2__swatch {
    align-items: center;
    display: flex;
    gap: 9px;
    min-height: 46px;
    padding: 10px;
  }

  .built-birdie-configurator-v2__swatch::before {
    background: var(--swatch, var(--bbv2-text));
    border: 1px solid rgba(17, 17, 17, 0.18);
    border-radius: 999px;
    content: "";
    flex: 0 0 auto;
    height: 18px;
    width: 18px;
  }

  .built-birdie-configurator-v2__swatch input,
  .built-birdie-configurator-v2__style input {
    cursor: pointer;
    inset: 0;
    opacity: 0;
    position: absolute;
  }

  .built-birdie-configurator-v2__swatch span {
    font-size: 0.9rem;
    font-weight: 800;
  }

  .built-birdie-configurator-v2__swatch small,
  .built-birdie-configurator-v2__style b {
    color: var(--bbv2-red);
    display: none;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .built-birdie-configurator-v2__swatch.is-coming-soon,
  .built-birdie-configurator-v2__style.is-coming-soon {
    opacity: 0.52;
  }

  .built-birdie-configurator-v2__swatch.is-coming-soon small,
  .built-birdie-configurator-v2__style.is-coming-soon b {
    display: block;
  }

  .built-birdie-configurator-v2__swatch:has(input:checked),
  .built-birdie-configurator-v2__style:has(input:checked) {
    background: rgba(15, 63, 46, 0.08);
    border-color: var(--bbv2-green);
    box-shadow: inset 0 0 0 1px var(--bbv2-green);
  }

  .built-birdie-configurator-v2__swatch:focus-within,
  .built-birdie-configurator-v2__style:focus-within,
  .built-birdie-configurator-v2__button:focus-visible,
  .built-birdie-configurator-v2__fallback:focus-visible {
    outline: 2px solid var(--bbv2-green);
    outline-offset: 3px;
  }

  .built-birdie-configurator-v2__swatch--black {
    --swatch: #101010;
  }

  .built-birdie-configurator-v2__swatch--white {
    --swatch: #ffffff;
  }

  .built-birdie-configurator-v2__swatch--navy,
  .built-birdie-configurator-v2__swatch--blue {
    --swatch: #17355f;
  }

  .built-birdie-configurator-v2__swatch--green {
    --swatch: var(--bbv2-green);
  }

  .built-birdie-configurator-v2__swatch--red {
    --swatch: var(--bbv2-red);
  }

  .built-birdie-configurator-v2__swatch--gold {
    --swatch: #c59a2d;
  }

  .built-birdie-configurator-v2__styles {
    display: grid;
    gap: 10px;
  }

  .built-birdie-configurator-v2__style {
    display: grid;
    gap: 7px;
    min-height: 112px;
    padding: 15px;
  }

  .built-birdie-configurator-v2__style span {
    font-size: 1.05rem;
    font-weight: 880;
  }

  .built-birdie-configurator-v2__stage {
    display: grid;
    gap: 14px;
    min-height: 680px;
    overflow: hidden;
    padding: clamp(18px, 3vw, 30px);
  }

  .built-birdie-configurator-v2__stage-top {
    align-items: end;
    display: flex;
    gap: 16px;
    justify-content: space-between;
  }

  .built-birdie-configurator-v2__stage-top span,
  .built-birdie-configurator-v2__summary-block span,
  .built-birdie-configurator-v2__items > span,
  .built-birdie-configurator-v2__total span,
  .built-birdie-configurator-v2__included-strip span {
    color: var(--bbv2-muted);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .built-birdie-configurator-v2__stage-top strong {
    font-size: clamp(1.4rem, 2.4vw, 2.4rem);
    font-weight: 930;
    letter-spacing: 0;
    line-height: 1;
    text-align: right;
  }

  .built-birdie-configurator-v2__visual {
    align-items: center;
    background:
      radial-gradient(circle at 50% 62%, rgba(15, 63, 46, 0.12), transparent 36%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.64), rgba(247, 241, 231, 0.82));
    border: 1px solid var(--bbv2-border);
    border-radius: 8px;
    display: flex;
    justify-content: center;
    min-height: 520px;
    overflow: hidden;
    position: relative;
  }

  .built-birdie-configurator-v2__visual::before {
    background: rgba(15, 63, 46, 0.12);
    border-radius: 50%;
    bottom: 54px;
    content: "";
    height: 70px;
    position: absolute;
    width: min(78%, 520px);
  }

  .built-birdie-configurator-v2__palette {
    display: flex;
    gap: 8px;
    left: 18px;
    position: absolute;
    top: 18px;
    z-index: 6;
  }

  .built-birdie-configurator-v2__palette span {
    align-items: center;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid var(--bbv2-border);
    border-radius: 999px;
    display: inline-flex;
    gap: 7px;
    min-height: 34px;
    padding: 7px 10px;
  }

  .built-birdie-configurator-v2__palette i {
    background: var(--chip-color, var(--bbv2-text));
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 999px;
    display: block;
    height: 14px;
    width: 14px;
  }

  .built-birdie-configurator-v2__palette b {
    color: var(--bbv2-text);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .built-birdie-configurator-v2__bag {
    height: min(72vw, 430px);
    max-height: 430px;
    position: relative;
    width: min(42vw, 270px);
    z-index: 2;
  }

  .built-birdie-configurator-v2__bag::before {
    background: var(--bbv2-bag, #101010);
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 8px;
    bottom: 42px;
    box-shadow: 0 28px 70px rgba(17, 17, 17, 0.2);
    content: "";
    left: 16%;
    position: absolute;
    right: 16%;
    top: 24%;
  }

  .built-birdie-configurator-v2__bag::after {
    background: var(--bbv2-accent, #101010);
    bottom: 44%;
    content: "";
    height: 14px;
    left: 5%;
    position: absolute;
    right: 5%;
    z-index: 3;
  }

  .built-birdie-configurator-v2__bag i {
    border: 10px solid var(--bbv2-bag, #101010);
    border-bottom: 0;
    border-radius: 999px 999px 0 0;
    display: block;
    height: 34%;
    left: 25%;
    position: absolute;
    top: 4%;
    width: 50%;
    z-index: 1;
  }

  .built-birdie-configurator-v2__bag span {
    background: color-mix(in srgb, var(--bbv2-bag, #101010) 84%, #ffffff);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    bottom: 20%;
    display: block;
    height: 20%;
    left: 29%;
    position: absolute;
    right: 29%;
    z-index: 4;
  }

  .built-birdie-configurator-v2__bag b {
    background: var(--bbv2-accent, #101010);
    border-radius: 999px;
    display: block;
    height: 14px;
    position: absolute;
    right: 24%;
    top: 35%;
    width: 14px;
    z-index: 5;
  }

  .built-birdie-configurator-v2__bag em {
    background: rgba(255, 255, 255, 0.42);
    display: block;
    height: 62%;
    left: 49%;
    position: absolute;
    top: 22%;
    transform: rotate(15deg);
    width: 3px;
    z-index: 4;
  }

  .built-birdie-configurator-v2__accessory {
    display: grid;
    gap: 8px;
    justify-items: center;
    position: absolute;
    transition: opacity 180ms ease, transform 180ms ease;
    width: clamp(88px, 12vw, 138px);
    z-index: 4;
  }

  .built-birdie-configurator-v2__accessory[hidden] {
    display: none;
  }

  .built-birdie-configurator-v2__accessory-media {
    align-items: center;
    aspect-ratio: 1;
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid var(--bbv2-border);
    border-radius: 8px;
    box-shadow: 0 16px 42px rgba(17, 17, 17, 0.1);
    display: flex;
    justify-content: center;
    overflow: hidden;
    width: 100%;
  }

  .built-birdie-configurator-v2__accessory-media span {
    color: var(--bbv2-green);
    font-size: 1.55rem;
    font-weight: 930;
  }

  .built-birdie-configurator-v2__accessory-image {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .built-birdie-configurator-v2__accessory p {
    background: var(--bbv2-text);
    border-radius: 999px;
    color: var(--bbv2-bg);
    font-size: 0.72rem;
    font-weight: 850;
    margin: 0;
    padding: 6px 9px;
    text-align: center;
    text-transform: uppercase;
  }

  .built-birdie-configurator-v2__accessory--upper-left {
    left: 7%;
    top: 16%;
  }

