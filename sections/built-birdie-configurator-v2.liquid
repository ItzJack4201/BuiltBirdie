{% javascript %}
  (() => {
    const moneyFormatter = new Intl.NumberFormat(document.documentElement.lang || 'en', {
      style: 'currency',
      currency: window.Shopify?.currency?.active || 'USD'
    });

    const labelize = (value) => value.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
    const swatches = {
      black: '#101010',
      white: '#ffffff',
      navy: '#17355f',
      blue: '#17355f',
      green: '#0f3f2e',
      red: '#b3261e',
      gold: '#c59a2d'
    };

    document.querySelectorAll('[data-bbv2-configurator]').forEach((configurator) => {
      const products = Array.from(configurator.querySelectorAll('[data-bbv2-product]'));
      const builds = Array.from(configurator.querySelectorAll('[data-bbv2-build]'));
      const optionLabels = Array.from(configurator.querySelectorAll('[data-bbv2-option]'));
      const stage = configurator.querySelector('[data-bbv2-stage]');
      const stageTitle = configurator.querySelector('[data-bbv2-stage-title]');
      const baseChip = configurator.querySelector('[data-bbv2-base-chip]');
      const accentChip = configurator.querySelector('[data-bbv2-accent-chip]');
      const baseLabel = configurator.querySelector('[data-bbv2-base-label]');
      const accentLabel = configurator.querySelector('[data-bbv2-accent-label]');
      const buildName = configurator.querySelector('[data-bbv2-build-name]');
      const why = configurator.querySelector('[data-bbv2-why]');
      const selection = configurator.querySelector('[data-bbv2-selection]');
      const itemsList = configurator.querySelector('[data-bbv2-items]');
      const total = configurator.querySelector('[data-bbv2-total]');
      const strip = configurator.querySelector('[data-bbv2-included-strip]');
      const dock = configurator.querySelector('[data-bbv2-dock]');
      const addButton = configurator.querySelector('[data-bbv2-add]');
      const message = configurator.querySelector('[data-bbv2-message]');
      const emptyMessage = configurator.dataset.bbv2EmptyMessage || 'Products are being mapped for this build. Shop the collection while this setup is finished.';
      const emptyStripLabel = configurator.dataset.bbv2EmptyStripLabel || 'Build mapping in progress';
      const comingSoonLabel = configurator.dataset.bbv2ComingSoonLabel || 'Coming soon';
      const loadingMessage = configurator.dataset.bbv2LoadingMessage || 'Building your cart...';
      const errorMessage = configurator.dataset.bbv2ErrorMessage || 'We could not build the full cart. Open the collection and add the kit items from there.';

      if (!stage || !addButton || !itemsList || !dock) {
        return;
      }

      const getChoice = (type) => configurator.querySelector(`[data-bbv2-choice="${type}"]:checked`)?.value || 'all';

      const matches = (product, bag, accent, style) => {
        const productBag = product.dataset.bag || 'all';
        const productAccent = product.dataset.accent || 'all';
        const productStyle = product.dataset.style || 'all';
        return product.dataset.supported !== 'false' && (productBag === 'all' || productBag === bag) && (productAccent === 'all' || productAccent === accent) && (productStyle === 'all' || productStyle === style);
      };

      const buildMatches = (build, criteria) => Object.entries(criteria).every(([key, value]) => {
        const buildValue = build.dataset[key] || 'all';
        return buildValue === 'all' || buildValue === value;
      });

      const selectionSupported = (bag, accent, style) => {
        if (builds.length === 0) {
          return products.some((product) => matches(product, bag, accent, style));
        }

        return builds.some((build) => build.dataset.supported !== 'false' && buildMatches(build, { bag, accent, style }));
      };

      const supportsChoice = (type, value) => {
        const bag = type === 'bag' ? value : getChoice('bag');
        const accent = type === 'accent' ? value : getChoice('accent');
        const style = type === 'style' ? value : getChoice('style');

        if (builds.length > 0) {
          if (type === 'bag') {
            return builds.some((build) => build.dataset.supported !== 'false' && buildMatches(build, { bag }));
          }

          if (type === 'accent') {
            return builds.some((build) => build.dataset.supported !== 'false' && buildMatches(build, { bag, accent }));
          }

          return builds.some((build) => build.dataset.supported !== 'false' && buildMatches(build, { bag, accent, style }));
        }

        return products.some((product) => matches(product, bag, accent, style));
      };

      const availableVisibleProducts = () => products.filter((product) => !product.hidden && product.dataset.variantId && product.dataset.available === 'true');

      const setOptionAvailability = () => {
        const applyAvailability = () => {
          optionLabels.forEach((label) => {
            const input = label.querySelector('input');
            const supported = supportsChoice(label.dataset.bbv2Option, label.dataset.bbv2OptionValue);
            label.classList.toggle('is-coming-soon', !supported);
            label.toggleAttribute('aria-disabled', !supported);
            if (input) {
              input.disabled = !supported;
            }
          });
        };

        for (let pass = 0; pass < 4; pass += 1) {
          let changed = false;
          applyAvailability();

          ['bag', 'accent', 'style'].forEach((type) => {
            const checked = configurator.querySelector(`[data-bbv2-choice="${type}"]:checked`);
            if (checked && checked.disabled) {
              const replacement = Array.from(configurator.querySelectorAll(`[data-bbv2-choice="${type}"]`)).find((choice) => supportsChoice(type, choice.value));
              if (replacement) {
                replacement.checked = true;
                changed = true;
              }
            }
          });

          if (!changed) {
            break;
          }
        }

        applyAvailability();
      };

      const renderItems = (visible) => {
        itemsList.replaceChildren();
        dock.replaceChildren();

        visible.forEach((product) => {
          const title = product.dataset.title || 'Built Birdie item';
          const role = product.dataset.role || 'Item';
          const price = Number(product.dataset.price || 0);
          const priceLabel = price > 0 ? moneyFormatter.format(price / 100) : comingSoonLabel;

          const item = document.createElement('li');
          const itemTitle = document.createElement('strong');
          const itemMeta = document.createElement('span');
          itemTitle.textContent = title;
          itemMeta.textContent = price > 0 ? priceLabel : role;
          item.append(itemTitle, itemMeta);
          itemsList.append(item);

          const dockCard = document.createElement('article');
          const dockMedia = document.createElement('div');
          const dockCopy = document.createElement('div');
          const dockRole = document.createElement('span');
          const dockTitle = document.createElement('strong');
          const dockPrice = document.createElement('span');
          const sourceImage = product.querySelector('.built-birdie-configurator-v2__accessory-image');
          const sourceFallback = product.querySelector('.built-birdie-configurator-v2__accessory-media span');
          dockCard.className = 'built-birdie-configurator-v2__dock-card';
          dockMedia.className = 'built-birdie-configurator-v2__dock-card-media';
          dockCopy.className = 'built-birdie-configurator-v2__dock-card-copy';
          dockRole.className = 'built-birdie-configurator-v2__dock-card-role';
          dockPrice.className = 'built-birdie-configurator-v2__dock-card-price';

          if (sourceImage) {
            const dockImage = document.createElement('img');
            dockImage.src = sourceImage.currentSrc || sourceImage.src;
            dockImage.alt = sourceImage.alt || title;
            dockImage.loading = 'lazy';
            dockMedia.append(dockImage);
          } else {
            const dockInitials = document.createElement('span');
            dockInitials.textContent = sourceFallback?.textContent || role.slice(0, 2).toUpperCase();
            dockMedia.append(dockInitials);
          }

          dockRole.textContent = role;
          dockTitle.textContent = title;
          dockPrice.textContent = priceLabel;
          dockCopy.append(dockRole, dockTitle, dockPrice);
          dockCard.append(dockMedia, dockCopy);
          dock.append(dockCard);
        });

        if (visible.length === 0) {
          const item = document.createElement('li');
          const itemTitle = document.createElement('strong');
          const itemMeta = document.createElement('span');
          itemTitle.textContent = emptyStripLabel;
          itemMeta.textContent = comingSoonLabel;
          item.append(itemTitle, itemMeta);
          itemsList.append(item);

          const dockCard = document.createElement('article');
          const dockMedia = document.createElement('div');
          const dockCopy = document.createElement('div');
          const dockInitials = document.createElement('span');
          const dockRole = document.createElement('span');
          const dockTitle = document.createElement('strong');
          const dockPrice = document.createElement('span');
          dockCard.className = 'built-birdie-configurator-v2__dock-card';
          dockMedia.className = 'built-birdie-configurator-v2__dock-card-media';
          dockCopy.className = 'built-birdie-configurator-v2__dock-card-copy';
          dockRole.className = 'built-birdie-configurator-v2__dock-card-role';
          dockPrice.className = 'built-birdie-configurator-v2__dock-card-price';
          dockInitials.textContent = 'BB';
          dockRole.textContent = comingSoonLabel;
          dockTitle.textContent = emptyStripLabel;
          dockPrice.textContent = emptyMessage;
          dockMedia.append(dockInitials);
          dockCopy.append(dockRole, dockTitle, dockPrice);
          dockCard.append(dockMedia, dockCopy);
          dock.append(dockCard);
        }
      };

      const update = () => {
        setOptionAvailability();

        const bag = getChoice('bag');
        const accent = getChoice('accent');
        const style = getChoice('style');
        const styleInput = configurator.querySelector('[data-bbv2-choice="style"]:checked');
        const styleTitle = styleInput?.dataset.bbv2StyleTitle || labelize(style);
        const styleNote = styleInput?.dataset.bbv2StyleNote || '';
        const supportedSelection = selectionSupported(bag, accent, style);

        products.forEach((product) => {
          product.hidden = !supportedSelection || !matches(product, bag, accent, style);
        });

        const visible = products.filter((product) => !product.hidden);
        const available = supportedSelection ? availableVisibleProducts() : [];
        const cents = available.reduce((sum, product) => sum + Number(product.dataset.price || 0), 0);
        const buildTitle = `${labelize(bag)} bag / ${labelize(accent)} accent`;
        const itemRoles = visible.map((product) => product.dataset.role).filter(Boolean).slice(0, 4);

        stage.style.setProperty('--bbv2-bag', swatches[bag] || '#101010');
        stage.style.setProperty('--bbv2-accent', swatches[accent] || '#101010');
        stageTitle.textContent = buildTitle;
        if (baseChip) {
          baseChip.style.setProperty('--chip-color', swatches[bag] || '#101010');
        }
        if (accentChip) {
          accentChip.style.setProperty('--chip-color', swatches[accent] || '#101010');
        }
        if (baseLabel) {
          baseLabel.textContent = `${labelize(bag)} base`;
        }
        if (accentLabel) {
          accentLabel.textContent = `${labelize(accent)} accent`;
        }
        buildName.textContent = `${styleTitle} setup`;
        why.textContent = styleNote;
        selection.textContent = `${buildTitle}. ${styleTitle} style.`;
        strip.textContent = itemRoles.length > 0 ? itemRoles.join(' / ') : emptyStripLabel;
        total.textContent = moneyFormatter.format(cents / 100);
        addButton.disabled = !supportedSelection || available.length === 0;
        message.textContent = available.length === 0 ? emptyMessage : '';
        message.dataset.bbv2MessageStatus = available.length === 0 ? 'notice' : '';
        renderItems(visible);
      };

      configurator.addEventListener('change', update);

      addButton.addEventListener('click', async () => {
        const items = availableVisibleProducts().map((product) => ({
          id: Number(product.dataset.variantId),
          quantity: 1
        }));

        if (items.length === 0) {
          update();
          return;
        }

        addButton.disabled = true;
        message.textContent = loadingMessage;
        message.dataset.bbv2MessageStatus = 'loading';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({ items })
          });

          if (!response.ok) {
            throw new Error('Cart request failed');
          }

          window.location.href = '/cart';
        } catch (error) {
          message.textContent = errorMessage;
          message.dataset.bbv2MessageStatus = 'error';
          addButton.disabled = false;
        }
      });

      update();
    });
  })();
{% endjavascript %}

