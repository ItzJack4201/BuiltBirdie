{% style %}
  #BuiltBirdieUtility-{{ section.id }} {
    --bbu-bg: {{ section.settings.background_color }};
    --bbu-panel: {{ section.settings.panel_color }};
    --bbu-cream: {{ section.settings.cream_color }};
    --bbu-text: {{ section.settings.text_color }};
    --bbu-muted: {{ section.settings.muted_color }};
    --bbu-green: {{ section.settings.accent_green }};
    --bbu-red: {{ section.settings.accent_red }};
    --bbu-border: rgba(17, 17, 17, 0.12);
  }
{% endstyle %}

<section id="BuiltBirdieUtility-{{ section.id }}" class="built-birdie-utility">
  <div class="built-birdie-utility__inner">
    <div class="built-birdie-utility__copy">
      <p class="built-birdie-utility__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <div class="built-birdie-utility__actions">
        {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
          {% capture primary_url %}
            {% render 'built-birdie-safe-link', link: section.settings.primary_link, fallback: routes.root_url %}
          {% endcapture %}
          <a class="built-birdie-utility__button built-birdie-utility__button--primary" href="{{ primary_url | strip }}">{{ section.settings.primary_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
          {% capture secondary_url %}
            {% render 'built-birdie-safe-link', link: section.settings.secondary_link, fallback: routes.root_url %}
          {% endcapture %}
          <a class="built-birdie-utility__button built-birdie-utility__button--secondary" href="{{ secondary_url | strip }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>

    <div class="built-birdie-utility__console" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <strong>{{ section.settings.console_code }}</strong>
    </div>
  </div>

  <div class="built-birdie-utility__routes">
    {% for block in section.blocks %}
      {% capture route_url %}
        {% render 'built-birdie-safe-link', link: block.settings.link, fallback: routes.root_url %}
      {% endcapture %}
      <a class="built-birdie-utility__route" href="{{ route_url | strip }}" {{ block.shopify_attributes }}>
        <span>{{ block.settings.kicker }}</span>
        <strong>{{ block.settings.title }}</strong>
        <p>{{ block.settings.text }}</p>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .built-birdie-utility {
    background:
      linear-gradient(90deg, rgba(15, 63, 46, 0.06) 1px, transparent 1px),
      linear-gradient(180deg, rgba(15, 63, 46, 0.06) 1px, transparent 1px),
      linear-gradient(180deg, var(--bbu-cream), var(--bbu-bg) 36%);
    background-size: 44px 44px, 44px 44px, auto;
    color: var(--bbu-text);
    padding: clamp(38px, 6vw, 78px) clamp(16px, 4vw, 56px) clamp(26px, 4vw, 48px);
  }

  .built-birdie-utility * {
    box-sizing: border-box;
  }

  .built-birdie-utility__inner,
  .built-birdie-utility__routes {
    margin-inline: auto;
    max-width: 1180px;
  }

  .built-birdie-utility__inner {
    align-items: end;
    display: grid;
    gap: clamp(24px, 4vw, 56px);
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.36fr);
  }

  .built-birdie-utility__eyebrow {
    color: var(--bbu-green);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .built-birdie-utility h1,
  .built-birdie-utility p {
    margin-block-start: 0;
  }

  .built-birdie-utility h1 {
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 930;
    letter-spacing: 0;
    line-height: 0.9;
    margin-block-end: 20px;
  }

  .built-birdie-utility__copy > p,
  .built-birdie-utility__route p {
    color: var(--bbu-muted);
    line-height: 1.55;
    max-width: 720px;
  }

  .built-birdie-utility__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 26px;
  }

  .built-birdie-utility__button {
    align-items: center;
    border-radius: 999px;
    display: inline-flex;
    font-weight: 850;
    justify-content: center;
    min-height: 48px;
    padding: 13px 20px;
    text-decoration: none;
  }

  .built-birdie-utility__button--primary {
    background: var(--bbu-text);
    color: var(--bbu-bg);
  }

  .built-birdie-utility__button--secondary {
    border: 1px solid var(--bbu-border);
    color: var(--bbu-text);
  }

  .built-birdie-utility__console,
  .built-birdie-utility__route {
    background: color-mix(in srgb, var(--bbu-panel) 88%, transparent);
    border: 1px solid var(--bbu-border);
    border-radius: 24px;
  }

  .built-birdie-utility__console {
    min-height: 260px;
    overflow: hidden;
    padding: 22px;
    position: relative;
  }

  .built-birdie-utility__console span {
    background: var(--bbu-cream);
    border-radius: 999px;
    display: block;
    height: 8px;
    margin-block-end: 10px;
    overflow: hidden;
    position: relative;
  }

  .built-birdie-utility__console span::after {
    background: var(--bbu-green);
    border-radius: inherit;
    content: "";
    inset: 0 auto 0 0;
    position: absolute;
    width: 74%;
  }

  .built-birdie-utility__console span:nth-child(2)::after {
    background: var(--bbu-red);
    width: 38%;
  }

  .built-birdie-utility__console span:nth-child(3)::after {
    width: 92%;
  }

  .built-birdie-utility__console strong {
    bottom: 22px;
    color: var(--bbu-green);
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 930;
    left: 22px;
    letter-spacing: 0;
    line-height: 0.9;
    position: absolute;
  }

  .built-birdie-utility__routes {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding-block-start: clamp(22px, 4vw, 40px);
  }

  .built-birdie-utility__route {
    color: var(--bbu-text);
    padding: 22px;
    text-decoration: none;
  }

  .built-birdie-utility__route span {
    color: var(--bbu-red);
    display: block;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    margin-block-end: 14px;
    text-transform: uppercase;
  }

  .built-birdie-utility__route strong {
    display: block;
    font-size: 1.16rem;
    font-weight: 900;
    line-height: 1.12;
    margin-block-end: 8px;
  }

  .built-birdie-utility__route p {
    margin-block-end: 0;
  }

  @media screen and (max-width: 989px) {
    .built-birdie-utility__inner,
    .built-birdie-utility__routes {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .built-birdie-utility {
      padding: 36px 16px 42px;
    }

    .built-birdie-utility h1 {
      font-size: clamp(3rem, 18vw, 5rem);
    }

    .built-birdie-utility__actions,
    .built-birdie-utility__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BB utility system",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BUILT BIRDIE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right route."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Use the Built Birdie system to get back to the right setup, collection, or support path."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Build Your Bag"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link",
      "default": "/pages/build-your-bag"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Shop Hub"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link",
      "default": "/pages/shop-hub"
    },
    {
      "type": "text",
      "id": "console_code",
      "label": "Console code",
      "default": "BB"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Panel",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Cream",
      "default": "#f7f1e7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5b5a54"
    },
    {
      "type": "color",
      "id": "accent_green",
      "label": "Dark green",
      "default": "#0f3f2e"
    },
    {
      "type": "color",
      "id": "accent_red",
      "label": "Red accent",
      "default": "#b3261e"
    }
  ],
  "blocks": [
    {
      "type": "route",
      "name": "Route",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Route"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Build Your Bag"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Return to the guided setup builder."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/pages/build-your-bag"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BB utility system"
    }
  ]
}
{% endschema %}
