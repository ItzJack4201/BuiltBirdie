{% style %}
  #BuiltBirdieSetupMatrix-{{ section.id }} {
    --bbm-bg: {{ section.settings.background_color }};
    --bbm-panel: {{ section.settings.panel_color }};
    --bbm-cream: {{ section.settings.cream_color }};
    --bbm-text: {{ section.settings.text_color }};
    --bbm-muted: {{ section.settings.muted_color }};
    --bbm-green: {{ section.settings.accent_green }};
    --bbm-red: {{ section.settings.accent_red }};
    --bbm-border: rgba(17, 17, 17, 0.12);
  }
{% endstyle %}

<section id="BuiltBirdieSetupMatrix-{{ section.id }}" class="built-birdie-setup-matrix">
  <div class="built-birdie-setup-matrix__inner">
    <div class="built-birdie-setup-matrix__head">
      <div>
        <p class="built-birdie-setup-matrix__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="built-birdie-setup-matrix__grid">
      {% for block in section.blocks %}
        <article class="built-birdie-setup-matrix__card" {{ block.shopify_attributes }}>
          <div class="built-birdie-setup-matrix__card-top">
            <span>{{ block.settings.kicker }}</span>
            <strong>{{ block.settings.score }}</strong>
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          <div class="built-birdie-setup-matrix__bar" aria-hidden="true">
            <i style="--bbm-score: {{ block.settings.score_width }}%"></i>
          </div>
          <dl class="built-birdie-setup-matrix__specs">
            <div>
              <dt>{{ section.settings.base_label }}</dt>
              <dd>{{ block.settings.base }}</dd>
            </div>
            <div>
              <dt>{{ section.settings.accent_label }}</dt>
              <dd>{{ block.settings.accent }}</dd>
            </div>
            <div>
              <dt>{{ section.settings.includes_label }}</dt>
              <dd>{{ block.settings.includes }}</dd>
            </div>
          </dl>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .built-birdie-setup-matrix {
    background:
      linear-gradient(90deg, rgba(15, 63, 46, 0.05) 1px, transparent 1px),
      linear-gradient(180deg, rgba(15, 63, 46, 0.05) 1px, transparent 1px),
      linear-gradient(180deg, var(--bbm-bg), var(--bbm-cream));
    background-size: 36px 36px, 36px 36px, auto;
    color: var(--bbm-text);
    padding: clamp(44px, 7vw, 92px) clamp(16px, 4vw, 56px);
  }

  .built-birdie-setup-matrix * {
    box-sizing: border-box;
  }

  .built-birdie-setup-matrix__inner {
    margin-inline: auto;
    max-width: 1180px;
  }

  .built-birdie-setup-matrix__head {
    align-items: end;
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(0, 0.76fr) minmax(280px, 0.4fr);
    margin-block-end: 18px;
  }

  .built-birdie-setup-matrix__eyebrow {
    color: var(--bbm-green);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .built-birdie-setup-matrix h2,
  .built-birdie-setup-matrix h3,
  .built-birdie-setup-matrix p {
    margin-block-start: 0;
  }

  .built-birdie-setup-matrix h2 {
    font-size: clamp(2.8rem, 6vw, 6rem);
    font-weight: 930;
    letter-spacing: 0;
    line-height: 0.9;
    margin-block-end: 0;
  }

  .built-birdie-setup-matrix__head > p {
    color: var(--bbm-muted);
    line-height: 1.55;
    margin-block-end: 0;
  }

  .built-birdie-setup-matrix__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .built-birdie-setup-matrix__card {
    background: color-mix(in srgb, var(--bbm-panel) 88%, transparent);
    border: 1px solid var(--bbm-border);
    border-radius: 8px;
    display: grid;
    gap: 16px;
    min-height: 100%;
    padding: 18px;
  }

  .built-birdie-setup-matrix__card-top {
    align-items: center;
    display: flex;
    gap: 12px;
    justify-content: space-between;
  }

  .built-birdie-setup-matrix__card-top span {
    color: var(--bbm-red);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .built-birdie-setup-matrix__card-top strong {
    background: var(--bbm-text);
    border-radius: 999px;
    color: var(--bbm-bg);
    font-size: 0.74rem;
    font-weight: 850;
    min-width: 52px;
    padding: 7px 9px;
    text-align: center;
  }

  .built-birdie-setup-matrix h3 {
    font-size: clamp(1.32rem, 2.2vw, 2rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1;
    margin-block-end: 0;
  }

  .built-birdie-setup-matrix__card > p {
    color: var(--bbm-muted);
    line-height: 1.5;
    margin-block-end: 0;
  }

  .built-birdie-setup-matrix__bar {
    background: rgba(17, 17, 17, 0.08);
    border-radius: 999px;
    height: 8px;
    overflow: hidden;
  }

  .built-birdie-setup-matrix__bar i {
    background: linear-gradient(90deg, var(--bbm-green), var(--bbm-red));
    display: block;
    height: 100%;
    width: var(--bbm-score);
  }

  .built-birdie-setup-matrix__specs {
    border-block: 1px solid var(--bbm-border);
    display: grid;
    gap: 0;
    margin: 0;
    padding-block: 8px;
  }

  .built-birdie-setup-matrix__specs div {
    display: grid;
    gap: 8px;
    grid-template-columns: 76px minmax(0, 1fr);
    padding-block: 8px;
  }

  .built-birdie-setup-matrix__specs dt {
    color: var(--bbm-muted);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .built-birdie-setup-matrix__specs dd {
    font-weight: 780;
    margin: 0;
  }

  .built-birdie-setup-matrix__card a {
    align-items: center;
    background: var(--bbm-text);
    border-radius: 999px;
    color: var(--bbm-bg);
    display: inline-flex;
    font-weight: 850;
    justify-content: center;
    min-height: 44px;
    padding: 11px 16px;
    text-decoration: none;
  }

  @media screen and (max-width: 989px) {
    .built-birdie-setup-matrix__head,
    .built-birdie-setup-matrix__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .built-birdie-setup-matrix {
      padding: 36px 16px 48px;
    }

    .built-birdie-setup-matrix__head,
    .built-birdie-setup-matrix__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
