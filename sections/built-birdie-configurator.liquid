{% liquid
  assign bag_colors = section.settings.bag_colors | split: ','
  assign accent_colors = section.settings.accent_colors | split: ','
%}

{% style %}
  #BuiltBirdieConfigurator-{{ section.id }} {
    --bbc-bg: {{ section.settings.background_color }};
    --bbc-cream: {{ section.settings.cream_color }};
    --bbc-text: {{ section.settings.text_color }};
    --bbc-muted: {{ section.settings.muted_color }};
    --bbc-green: {{ section.settings.accent_green }};
    --bbc-red: {{ section.settings.accent_red }};
    --bbc-border: rgba(17, 17, 17, 0.12);
  }
{% endstyle %}

<section
  id="BuiltBirdieConfigurator-{{ section.id }}"
  class="built-birdie-configurator"
  data-bb-configurator
  data-bb-empty-message="{{ section.settings.empty_message | escape }}"
  data-bb-loading-message="{{ section.settings.loading_message | escape }}"
  data-bb-error-message="{{ section.settings.error_message | escape }}"
>
  <div class="built-birdie-configurator__inner">
    <div class="built-birdie-configurator__header">
      <p class="built-birdie-configurator__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="built-birdie-configurator__layout">
      <div class="built-birdie-configurator__builder">
        <fieldset class="built-birdie-configurator__fieldset">
          <legend>{{ section.settings.bag_label }}</legend>
          <div class="built-birdie-configurator__options">
            {% for color in bag_colors %}
              {% liquid
                assign color_label = color | strip
                assign color_handle = color_label | handleize
              %}
              <label class="built-birdie-configurator__option built-birdie-configurator__option--{{ color_handle }}">
                <input type="radio" name="bb-bag-{{ section.id }}" value="{{ color_handle }}" data-bb-choice="bag" {% if forloop.first %}checked{% endif %}>
                <span>{{ color_label }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        <fieldset class="built-birdie-configurator__fieldset">
          <legend>{{ section.settings.accent_label }}</legend>
          <div class="built-birdie-configurator__options">
            {% for color in accent_colors %}
              {% liquid
                assign color_label = color | strip
                assign color_handle = color_label | handleize
              %}
              <label class="built-birdie-configurator__option built-birdie-configurator__option--{{ color_handle }}">
                <input type="radio" name="bb-accent-{{ section.id }}" value="{{ color_handle }}" data-bb-choice="accent" {% if forloop.first %}checked{% endif %}>
                <span>{{ color_label }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        <fieldset class="built-birdie-configurator__fieldset">
          <legend>{{ section.settings.style_label }}</legend>
          <div class="built-birdie-configurator__style-grid">
            {% for block in section.blocks %}
              {% if block.type == 'style_card' %}
                <label class="built-birdie-configurator__style" {{ block.shopify_attributes }}>
                  <input
                    type="radio"
                    name="bb-style-{{ section.id }}"
                    value="{{ block.settings.style_key }}"
                    data-bb-choice="style"
                    data-bb-style-title="{{ block.settings.title | escape }}"
                    data-bb-style-note="{{ block.settings.cart_note | escape }}"
                    {% if forloop.first %}checked{% endif %}
                  >
                  <span>{{ block.settings.title }}</span>
                  <small>{{ block.settings.description }}</small>
                </label>
              {% endif %}
            {% endfor %}
          </div>
        </fieldset>
      </div>

      <aside class="built-birdie-configurator__summary" aria-live="polite">
        <p class="built-birdie-configurator__eyebrow">{{ section.settings.summary_eyebrow }}</p>
        <h2>{{ section.settings.summary_heading }}</h2>
        <p data-bb-summary-copy>{{ section.settings.summary_copy }}</p>
        <div class="built-birdie-configurator__console">
          <div class="built-birdie-configurator__preview" aria-hidden="true" data-bb-preview>
            <span></span>
            <i></i>
          </div>
          <div class="built-birdie-configurator__readout">
            <span>{{ section.settings.build_code_label }}</span>
            <strong data-bb-build-code>BB-BLK-BLK-CLN</strong>
            <small data-bb-kit-note>{{ section.settings.default_kit_note }}</small>
          </div>
        </div>
        <div class="built-birdie-configurator__metrics">
          <div>
            <span>{{ section.settings.score_label }}</span>
            <strong data-bb-score>0%</strong>
          </div>
          <div>
            <span>{{ section.settings.included_label }}</span>
            <strong data-bb-included>0</strong>
          </div>
        </div>
        <div class="built-birdie-configurator__selected">
          <span data-bb-selected-bag>Black bag</span>
          <span data-bb-selected-accent>Black accent</span>
          <span data-bb-selected-style>Clean setup</span>
        </div>
        <div class="built-birdie-configurator__total">
          <span>{{ section.settings.total_label }}</span>
          <strong data-bb-total>{{ 0 | money }}</strong>
        </div>
        <button type="button" class="built-birdie-configurator__button" data-bb-add>
          {{ section.settings.add_button_label }}
        </button>
        <a class="built-birdie-configurator__fallback" href="{{ routes.collections_url }}/build-your-bag">
          {{ section.settings.fallback_label }}
        </a>
        <p class="built-birdie-configurator__message" data-bb-message></p>
      </aside>
    </div>

    <div class="built-birdie-configurator__recommendations">
      <div class="built-birdie-configurator__section-head">
        <p class="built-birdie-configurator__eyebrow">{{ section.settings.recommendations_eyebrow }}</p>
        <h2>{{ section.settings.recommendations_heading }}</h2>
      </div>

      <div class="built-birdie-configurator__product-grid" data-bb-products>
        {% for block in section.blocks %}
          {% if block.type == 'product_slot' %}
            {% liquid
              assign slot_product = block.settings.product
              assign slot_variant = blank
              assign slot_price = 0
              assign slot_available = false

              if slot_product != blank
                assign slot_variant = slot_product.selected_or_first_available_variant
                assign slot_price = slot_variant.price
                assign slot_available = slot_variant.available
              endif
            %}
            <article
              class="built-birdie-configurator__product"
              data-bb-product
              data-bag="{{ block.settings.bag_color }}"
              data-accent="{{ block.settings.accent_color }}"
              data-style="{{ block.settings.style_group }}"
              data-variant-id="{% if slot_variant != blank %}{{ slot_variant.id }}{% endif %}"
              data-price="{{ slot_price }}"
              data-available="{{ slot_available }}"
              {{ block.shopify_attributes }}
            >
              <label class="built-birdie-configurator__include">
                <input type="checkbox" data-bb-include {% if slot_variant != blank and slot_available %}checked{% endif %} {% if slot_variant == blank or slot_available == false %}disabled{% endif %}>
                <span>{{ section.settings.include_label }}</span>
              </label>

              <div class="built-birdie-configurator__product-media">
                {% if slot_product.featured_image != blank %}
                  {{ slot_product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', class: 'built-birdie-configurator__product-image', alt: slot_product.title }}
                {% else %}
                  <span>{{ block.settings.fallback_initials }}</span>
                {% endif %}
              </div>

              <div class="built-birdie-configurator__product-copy">
                <p>{{ block.settings.role }}</p>
                {% if slot_product != blank %}
                  <h3>{{ slot_product.title }}</h3>
                  <span>{{ slot_price | money }}</span>
                {% else %}
                  <h3>{{ block.settings.placeholder_title }}</h3>
                  <span>{{ section.settings.unassigned_label }}</span>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .built-birdie-configurator {
    background: linear-gradient(180deg, var(--bbc-cream), var(--bbc-bg) 30%);
    color: var(--bbc-text);
    padding: clamp(40px, 7vw, 92px) clamp(16px, 4vw, 56px);
  }

  .built-birdie-configurator * {
    box-sizing: border-box;
  }

  .built-birdie-configurator__inner {
    margin-inline: auto;
    max-width: 1180px;
  }

  .built-birdie-configurator__header {
    margin-block-end: clamp(30px, 5vw, 56px);
    max-width: 820px;
  }

  .built-birdie-configurator__eyebrow {
    color: var(--bbc-green);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .built-birdie-configurator h1,
  .built-birdie-configurator h2,
  .built-birdie-configurator h3,
  .built-birdie-configurator p {
    margin-block-start: 0;
  }

  .built-birdie-configurator h1 {
    font-size: clamp(3.1rem, 8vw, 7rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.9;
    margin-block-end: 22px;
  }

  .built-birdie-configurator__header p,
  .built-birdie-configurator__summary p,
  .built-birdie-configurator__style small {
    color: var(--bbc-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .built-birdie-configurator__layout {
    align-items: start;
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.42fr);
  }

  .built-birdie-configurator__builder,
  .built-birdie-configurator__summary,
  .built-birdie-configurator__product {
    background: rgba(255, 255, 255, 0.84);
    border: 1px solid var(--bbc-border);
    border-radius: 8px;
  }

  .built-birdie-configurator__builder {
    display: grid;
    gap: 18px;
    padding: clamp(18px, 3vw, 30px);
  }

  .built-birdie-configurator__fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .built-birdie-configurator__fieldset legend {
    font-size: 0.85rem;
    font-weight: 850;
    margin-block-end: 12px;
    text-transform: uppercase;
  }

  .built-birdie-configurator__options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .built-birdie-configurator__option,
  .built-birdie-configurator__style {
    cursor: pointer;
    position: relative;
  }

  .built-birdie-configurator__option {
    align-items: center;
    border: 1px solid var(--bbc-border);
    border-radius: 999px;
    display: inline-flex;
    gap: 9px;
    min-height: 44px;
    padding: 9px 14px 9px 10px;
  }

  .built-birdie-configurator__option input,
  .built-birdie-configurator__style input {
    cursor: pointer;
    inset: 0;
    opacity: 0;
    position: absolute;
  }

  .built-birdie-configurator__option::before {
    background: var(--swatch, var(--bbc-text));
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 999px;
    content: "";
    height: 18px;
    width: 18px;
  }

  .built-birdie-configurator__option span {
    font-size: 0.93rem;
    font-weight: 800;
  }

  .built-birdie-configurator__option:has(input:checked),
  .built-birdie-configurator__style:has(input:checked) {
    background: rgba(15, 63, 46, 0.08);
    border-color: var(--bbc-green);
  }

  .built-birdie-configurator__option:focus-within,
  .built-birdie-configurator__style:focus-within,
  .built-birdie-configurator__include:focus-within {
    outline: 2px solid var(--bbc-green);
    outline-offset: 3px;
  }

  .built-birdie-configurator__option--black {
    --swatch: #101010;
  }

  .built-birdie-configurator__option--white {
    --swatch: #ffffff;
  }

  .built-birdie-configurator__option--navy,
  .built-birdie-configurator__option--blue {
    --swatch: #17355f;
  }

  .built-birdie-configurator__option--green {
    --swatch: var(--bbc-green);
  }

  .built-birdie-configurator__option--red {
    --swatch: var(--bbc-red);
  }

  .built-birdie-configurator__option--gold {
    --swatch: #c59a2d;
  }

  .built-birdie-configurator__style-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .built-birdie-configurator__style {
    border: 1px solid var(--bbc-border);
    border-radius: 8px;
    display: grid;
    gap: 8px;
    min-height: 126px;
    padding: 18px;
  }

  .built-birdie-configurator__style span {
    font-size: 1.08rem;
    font-weight: 850;
  }

  .built-birdie-configurator__summary {
    padding: clamp(20px, 3vw, 30px);
    position: sticky;
    top: 18px;
  }

  .built-birdie-configurator h2 {
    font-size: clamp(1.8rem, 3.8vw, 3rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1;
    margin-block-end: 12px;
  }

  .built-birdie-configurator__console {
    align-items: stretch;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      var(--bbc-text);
    background-size: 22px 22px, 22px 22px, auto;
    border-radius: 8px;
    color: var(--bbc-bg);
    display: grid;
    gap: 16px;
    grid-template-columns: 112px minmax(0, 1fr);
    margin-block-start: 20px;
    padding: 16px;
  }

  .built-birdie-configurator__preview {
    align-items: end;
    aspect-ratio: 1;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04));
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    display: flex;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .built-birdie-configurator__preview::before {
    background: var(--bb-bag-swatch, #101010);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 10px 10px 6px 6px;
    bottom: 18px;
    content: "";
    height: 58px;
    position: absolute;
    width: 62px;
  }

  .built-birdie-configurator__preview::after {
    background: transparent;
    border: 5px solid var(--bb-bag-swatch, #101010);
    border-bottom: 0;
    border-radius: 999px 999px 0 0;
    content: "";
    height: 32px;
    position: absolute;
    top: 19px;
    width: 42px;
  }

  .built-birdie-configurator__preview span {
    background: var(--bb-accent-swatch, #101010);
    bottom: 34px;
    height: 8px;
    position: absolute;
    width: 74px;
    z-index: 1;
  }

  .built-birdie-configurator__preview i {
    background: var(--bbc-red);
    border-radius: 999px;
    bottom: 68px;
    height: 9px;
    position: absolute;
    right: 25px;
    width: 9px;
    z-index: 1;
  }

  .built-birdie-configurator__readout {
    align-content: center;
    display: grid;
    gap: 8px;
  }

  .built-birdie-configurator__readout span,
  .built-birdie-configurator__metrics span {
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .built-birdie-configurator__readout strong {
    color: var(--bbc-bg);
    font-size: clamp(1.25rem, 3.2vw, 2rem);
    letter-spacing: 0;
    line-height: 1;
  }

  .built-birdie-configurator__readout small {
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.4;
  }

  .built-birdie-configurator__metrics {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: 10px;
  }

  .built-birdie-configurator__metrics div {
    background: var(--bbc-text);
    border-radius: 8px;
    display: grid;
    gap: 4px;
    padding: 12px;
  }

  .built-birdie-configurator__metrics strong {
    color: var(--bbc-bg);
    font-size: 1.35rem;
    line-height: 1;
  }

  .built-birdie-configurator__selected {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 20px;
  }

  .built-birdie-configurator__selected span {
    background: var(--bbc-cream);
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 7px 10px;
  }

  .built-birdie-configurator__total {
    align-items: center;
    border-block: 1px solid var(--bbc-border);
    display: flex;
    justify-content: space-between;
    margin-block: 18px;
    padding-block: 16px;
  }

  .built-birdie-configurator__total span {
    color: var(--bbc-muted);
    font-weight: 750;
  }

  .built-birdie-configurator__total strong {
    font-size: 1.35rem;
  }

  .built-birdie-configurator__button,
  .built-birdie-configurator__fallback {
    align-items: center;
    border-radius: 999px;
    display: inline-flex;
    font-weight: 850;
    justify-content: center;
    min-height: 48px;
    text-decoration: none;
    width: 100%;
  }

  .built-birdie-configurator__button {
    background: var(--bbc-text);
    border: 0;
    color: var(--bbc-bg);
    cursor: pointer;
    font: inherit;
    padding: 14px 18px;
  }

  .built-birdie-configurator__button:disabled {
    cursor: not-allowed;
    opacity: 0.48;
  }

  .built-birdie-configurator__fallback {
    border: 1px solid var(--bbc-border);
    color: var(--bbc-text);
    margin-block-start: 10px;
    padding: 12px 18px;
  }

  .built-birdie-configurator__message {
    color: var(--bbc-muted);
    font-size: 0.9rem;
    margin-block: 12px 0;
  }

  .built-birdie-configurator__message[data-bb-message-status="notice"],
  .built-birdie-configurator__message[data-bb-message-status="loading"] {
    color: var(--bbc-green);
  }

  .built-birdie-configurator__message[data-bb-message-status="error"] {
    color: var(--bbc-red);
  }

  .built-birdie-configurator__recommendations {
    padding-block-start: clamp(38px, 6vw, 72px);
  }

  .built-birdie-configurator__section-head {
    margin-block-end: 20px;
  }

  .built-birdie-configurator__product-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .built-birdie-configurator__product {
    display: grid;
    gap: 14px;
    min-height: 100%;
    padding: 14px;
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }

  .built-birdie-configurator__product:hover {
    border-color: color-mix(in srgb, var(--bbc-green) 38%, var(--bbc-border));
    transform: translateY(-2px);
  }

  .built-birdie-configurator__product[hidden] {
    display: none;
  }

  .built-birdie-configurator__include {
    align-items: center;
    display: inline-flex;
    gap: 8px;
    justify-self: start;
  }

  .built-birdie-configurator__include:has(input:disabled) {
    opacity: 0.58;
  }

  .built-birdie-configurator__include span {
    color: var(--bbc-muted);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .built-birdie-configurator__product-media {
    align-items: center;
    aspect-ratio: 1.2;
    background: linear-gradient(135deg, var(--bbc-cream), #ffffff);
    border-radius: 8px;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .built-birdie-configurator__product-media span {
    color: var(--bbc-green);
    font-size: 2rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .built-birdie-configurator__product-image {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .built-birdie-configurator__product-copy p {
    color: var(--bbc-red);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    margin-block-end: 8px;
    text-transform: uppercase;
  }

  .built-birdie-configurator h3 {
    font-size: 1.05rem;
    font-weight: 850;
    line-height: 1.2;
    margin-block-end: 8px;
  }

  .built-birdie-configurator__product-copy span {
    color: var(--bbc-muted);
    font-weight: 750;
  }

  .built-birdie-configurator__product[data-available="false"] .built-birdie-configurator__product-media {
    filter: saturate(0.86);
  }

  @media screen and (max-width: 989px) {
    .built-birdie-configurator__layout,
    .built-birdie-configurator__product-grid {
      grid-template-columns: 1fr 1fr;
    }

    .built-birdie-configurator__summary {
      position: static;
    }
  }

  @media screen and (max-width: 749px) {
    .built-birdie-configurator {
      padding: 36px 16px 52px;
    }

    .built-birdie-configurator__layout,
    .built-birdie-configurator__style-grid,
    .built-birdie-configurator__product-grid {
      grid-template-columns: 1fr;
    }

    .built-birdie-configurator h1 {
      font-size: clamp(3rem, 18vw, 5rem);
    }

    .built-birdie-configurator__console {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const moneyFormatter = new Intl.NumberFormat(document.documentElement.lang || 'en', {
      style: 'currency',
      currency: window.Shopify?.currency?.active || 'USD'
    });

    const labelize = (value) => value.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
    const swatches = {
      black: '#101010',
      white: '#ffffff',
      navy: '#17355f',
      blue: '#17355f',
      green: '#0f3f2e',
      red: '#b3261e',
      gold: '#c59a2d'
    };
    const codes = {
      black: 'BLK',
      white: 'WHT',
      navy: 'NVY',
      blue: 'BLU',
      green: 'GRN',
      red: 'RED',
      gold: 'GLD',
      clean: 'CLN',
      starter: 'STR',
      tour: 'TR',
      gift: 'GFT'
    };

    document.querySelectorAll('[data-bb-configurator]').forEach((configurator) => {
      const products = Array.from(configurator.querySelectorAll('[data-bb-product]'));
      const addButton = configurator.querySelector('[data-bb-add]');
      const total = configurator.querySelector('[data-bb-total]');
      const message = configurator.querySelector('[data-bb-message]');
      const selectedBag = configurator.querySelector('[data-bb-selected-bag]');
      const selectedAccent = configurator.querySelector('[data-bb-selected-accent]');
      const selectedStyle = configurator.querySelector('[data-bb-selected-style]');
      const buildCode = configurator.querySelector('[data-bb-build-code]');
      const kitNote = configurator.querySelector('[data-bb-kit-note]');
      const score = configurator.querySelector('[data-bb-score]');
      const includedCount = configurator.querySelector('[data-bb-included]');
      const preview = configurator.querySelector('[data-bb-preview]');
      const emptyMessage = configurator.dataset.bbEmptyMessage || 'This build is ready for products. Shop the Build Your Bag collection while the kit slots are finished.';
      const loadingMessage = configurator.dataset.bbLoadingMessage || 'Building your cart...';
      const errorMessage = configurator.dataset.bbErrorMessage || 'We could not build the full cart. Open the collection and add the kit items from there.';

      if (!addButton || !total || !preview) {
        return;
      }

      const getChoice = (type) => configurator.querySelector(`[data-bb-choice="${type}"]:checked`)?.value || 'all';

      const matchRank = (product, bag, accent, style) => {
        const productBag = product.dataset.bag || 'all';
        const productAccent = product.dataset.accent || 'all';
        const productStyle = product.dataset.style || 'all';
        const bagCompatible = productBag === 'all' || productBag === bag;
        const accentCompatible = productAccent === 'all' || productAccent === accent;
        const styleCompatible = productStyle === 'all' || productStyle === style;

        if (bagCompatible && accentCompatible && styleCompatible) {
          let rank = 30;
          rank += productBag === bag ? 8 : 1;
          rank += productAccent === accent ? 8 : 1;
          rank += productStyle === style ? 10 : 2;
          return rank;
        }

        if (styleCompatible && productBag === 'all' && productAccent === 'all') {
          return 18;
        }

        if (productStyle === 'all' && bagCompatible && accentCompatible) {
          return 14;
        }

        return 0;
      };

      const setVisibleProducts = (bag, accent, style) => {
        const ranked = products.map((product) => ({
          product,
          rank: matchRank(product, bag, accent, style)
        }));
        const bestRank = ranked.reduce((best, item) => Math.max(best, item.rank), 0);
        const minimumRank = bestRank >= 30 ? 30 : bestRank > 0 ? bestRank : -1;

        ranked.forEach((item) => {
          item.product.hidden = item.rank < minimumRank;
        });
      };

      const visibleIncludedProducts = () => products.filter((product) => {
        const checkbox = product.querySelector('[data-bb-include]');
        return !product.hidden && checkbox?.checked && product.dataset.variantId && product.dataset.available === 'true';
      });

      const update = () => {
        const bag = getChoice('bag');
        const accent = getChoice('accent');
        const style = getChoice('style');

        setVisibleProducts(bag, accent, style);

        const included = visibleIncludedProducts();
        const cents = included.reduce((sum, product) => sum + Number(product.dataset.price || 0), 0);
        const styleInput = configurator.querySelector('[data-bb-choice="style"]:checked');
        const styleTitle = styleInput?.dataset.bbStyleTitle || labelize(style);
        const styleNote = styleInput?.dataset.bbStyleNote || '';
        const matchScore = Math.min(98, 70 + Math.max(included.length, 1) * 7 + (bag !== accent ? 6 : 0));

        selectedBag.textContent = `${labelize(bag)} bag`;
        selectedAccent.textContent = `${labelize(accent)} accent`;
        selectedStyle.textContent = `${styleTitle} setup`;
        buildCode.textContent = `BB-${codes[bag] || bag.slice(0, 3).toUpperCase()}-${codes[accent] || accent.slice(0, 3).toUpperCase()}-${codes[style] || style.slice(0, 3).toUpperCase()}`;
        kitNote.textContent = styleNote;
        score.textContent = `${matchScore}%`;
        includedCount.textContent = included.length;
        preview.style.setProperty('--bb-bag-swatch', swatches[bag] || '#101010');
        preview.style.setProperty('--bb-accent-swatch', swatches[accent] || '#101010');
        total.textContent = moneyFormatter.format(cents / 100);
        addButton.disabled = included.length === 0;
        message.textContent = included.length === 0 ? emptyMessage : '';
        message.dataset.bbMessageStatus = included.length === 0 ? 'notice' : '';
      };

      configurator.addEventListener('change', update);

      addButton.addEventListener('click', async () => {
        const items = visibleIncludedProducts().map((product) => ({
          id: Number(product.dataset.variantId),
          quantity: 1
        }));

        if (items.length === 0) {
          update();
          return;
        }

        addButton.disabled = true;
        message.textContent = loadingMessage;
        message.dataset.bbMessageStatus = 'loading';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({ items })
          });

          if (!response.ok) {
            throw new Error('Cart request failed');
          }

          window.location.href = '/cart';
        } catch (error) {
          message.textContent = errorMessage;
          message.dataset.bbMessageStatus = 'error';
          addButton.disabled = false;
        }
      });

      update();
    });
  })();
{% endjavascript %}

