{% style %}
  #BuiltBirdieEditorial-{{ section.id }} {
    --bbe-bg: {{ section.settings.background_color }};
    --bbe-panel: {{ section.settings.panel_color }};
    --bbe-cream: {{ section.settings.cream_color }};
    --bbe-text: {{ section.settings.text_color }};
    --bbe-muted: {{ section.settings.muted_color }};
    --bbe-green: {{ section.settings.accent_green }};
    --bbe-red: {{ section.settings.accent_red }};
    --bbe-border: rgba(17, 17, 17, 0.12);
  }
{% endstyle %}

<section id="BuiltBirdieEditorial-{{ section.id }}" class="built-birdie-editorial">
  <div class="built-birdie-editorial__inner">
    <div>
      <p class="built-birdie-editorial__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="built-birdie-editorial__index" aria-label="{{ section.settings.index_label | escape }}">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <span>{{ block.settings.kicker }}</span>
          <strong>{{ block.settings.title }}</strong>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .built-birdie-editorial {
    background:
      linear-gradient(90deg, rgba(15, 63, 46, 0.06) 1px, transparent 1px),
      linear-gradient(180deg, rgba(15, 63, 46, 0.06) 1px, transparent 1px),
      linear-gradient(180deg, var(--bbe-cream), var(--bbe-bg) 36%);
    background-size: 44px 44px, 44px 44px, auto;
    color: var(--bbe-text);
    padding: clamp(38px, 6vw, 82px) clamp(16px, 4vw, 56px);
  }

  .built-birdie-editorial * {
    box-sizing: border-box;
  }

  .built-birdie-editorial__inner {
    align-items: end;
    display: grid;
    gap: clamp(24px, 4vw, 56px);
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.38fr);
    margin-inline: auto;
    max-width: 1180px;
  }

  .built-birdie-editorial__eyebrow {
    color: var(--bbe-green);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .built-birdie-editorial h1,
  .built-birdie-editorial p {
    margin-block-start: 0;
  }

  .built-birdie-editorial h1 {
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 930;
    letter-spacing: 0;
    line-height: 0.9;
    margin-block-end: 20px;
  }

  .built-birdie-editorial p {
    color: var(--bbe-muted);
    line-height: 1.55;
    max-width: 760px;
  }

  .built-birdie-editorial__index {
    background: color-mix(in srgb, var(--bbe-panel) 88%, transparent);
    border: 1px solid var(--bbe-border);
    border-radius: 24px;
    display: grid;
    gap: 1px;
    overflow: hidden;
  }

  .built-birdie-editorial__index a {
    background: rgba(255, 255, 255, 0.64);
    color: var(--bbe-text);
    padding: 18px;
    text-decoration: none;
  }

  .built-birdie-editorial__index span {
    color: var(--bbe-red);
    display: block;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    margin-block-end: 8px;
    text-transform: uppercase;
  }

  .built-birdie-editorial__index strong {
    display: block;
    font-size: 1.08rem;
    font-weight: 900;
    line-height: 1.1;
  }

  @media screen and (max-width: 989px) {
    .built-birdie-editorial__inner {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .built-birdie-editorial {
      padding: 36px 16px 48px;
    }

    .built-birdie-editorial h1 {
      font-size: clamp(3rem, 18vw, 5rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BB editorial system",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BUILT BIRDIE JOURNAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better bag thinking."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Guides, systems, and simple notes for building a cleaner golf setup."
    },
    {
      "type": "text",
      "id": "index_label",
      "label": "Index label",
      "default": "Editorial routes"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Panel",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Cream",
      "default": "#f7f1e7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#101010"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5b5a54"
    },
    {
      "type": "color",
      "id": "accent_green",
      "label": "Dark green",
      "default": "#0f3f2e"
    },
    {
      "type": "color",
      "id": "accent_red",
      "label": "Red accent",
      "default": "#b3261e"
    }
  ],
  "blocks": [
    {
      "type": "editorial_link",
      "name": "Editorial link",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Guide"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Color Lab"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/pages/color-lab"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BB editorial system"
    }
  ]
}
{% endschema %}
