{% style %}
  #BuiltBirdieRouteMap-{{ section.id }} {
    --bbr-bg: {{ section.settings.background_color }};
    --bbr-panel: {{ section.settings.panel_color }};
    --bbr-cream: {{ section.settings.cream_color }};
    --bbr-text: {{ section.settings.text_color }};
    --bbr-muted: {{ section.settings.muted_color }};
    --bbr-green: {{ section.settings.accent_green }};
    --bbr-red: {{ section.settings.accent_red }};
    --bbr-border: rgba(17, 17, 17, 0.12);
  }
{% endstyle %}

<section id="BuiltBirdieRouteMap-{{ section.id }}" class="built-birdie-route-map">
  <div class="built-birdie-route-map__inner">
    <div class="built-birdie-route-map__head">
      <p class="built-birdie-route-map__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="built-birdie-route-map__matrix" aria-label="{{ section.settings.matrix_label | escape }}">
      <span>{{ section.settings.matrix_one }}</span>
      <span>{{ section.settings.matrix_two }}</span>
      <span>{{ section.settings.matrix_three }}</span>
      <span>{{ section.settings.matrix_four }}</span>
    </div>

    <div class="built-birdie-route-map__grid">
      {% for block in section.blocks %}
        {% capture route_url %}
          {% render 'built-birdie-safe-link', link: block.settings.link, fallback: routes.root_url %}
        {% endcapture %}
        <a class="built-birdie-route-map__card" href="{{ route_url | strip }}" {{ block.shopify_attributes }}>
          <span>{{ block.settings.kicker }}</span>
          <strong>{{ block.settings.title }}</strong>
          <p>{{ block.settings.text }}</p>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .built-birdie-route-map {
    background:
      linear-gradient(90deg, rgba(15, 63, 46, 0.05) 1px, transparent 1px),
      linear-gradient(180deg, rgba(15, 63, 46, 0.05) 1px, transparent 1px),
      var(--bbr-bg);
    background-size: 44px 44px, 44px 44px, auto;
    color: var(--bbr-text);
    padding: clamp(44px, 7vw, 92px) clamp(16px, 4vw, 56px);
  }

  .built-birdie-route-map * {
    box-sizing: border-box;
  }

  .built-birdie-route-map__inner {
    margin-inline: auto;
    max-width: 1180px;
  }

  .built-birdie-route-map__head {
    align-items: end;
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 0.72fr) minmax(280px, 0.42fr);
    margin-block-end: 18px;
  }

  .built-birdie-route-map__eyebrow {
    color: var(--bbr-green);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .built-birdie-route-map h2,
  .built-birdie-route-map p {
    margin-block-start: 0;
  }

  .built-birdie-route-map h2 {
    font-size: clamp(2.4rem, 5vw, 5.2rem);
    font-weight: 930;
    letter-spacing: 0;
    line-height: 0.92;
    margin-block-end: 0;
  }

  .built-birdie-route-map__head > p {
    color: var(--bbr-muted);
    line-height: 1.55;
    margin-block-end: 0;
  }

  .built-birdie-route-map__matrix {
    border: 1px solid var(--bbr-border);
    border-radius: 8px;
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block-end: 14px;
    overflow: hidden;
  }

  .built-birdie-route-map__matrix span {
    background: color-mix(in srgb, var(--bbr-panel) 88%, transparent);
    color: var(--bbr-green);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    min-height: 54px;
    padding: 18px;
    text-align: center;
    text-transform: uppercase;
  }

  .built-birdie-route-map__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .built-birdie-route-map__card {
    background: color-mix(in srgb, var(--bbr-panel) 88%, transparent);
    border: 1px solid var(--bbr-border);
    border-radius: 8px;
    color: var(--bbr-text);
    min-height: 180px;
    padding: 22px;
    text-decoration: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .built-birdie-route-map__card:hover {
    border-color: color-mix(in srgb, var(--bbr-green) 55%, var(--bbr-border));
    box-shadow: 0 18px 42px rgba(17, 17, 17, 0.08);
    transform: translateY(-3px);
  }

  .built-birdie-route-map__card span {
    color: var(--bbr-red);
    display: block;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    margin-block-end: 22px;
    text-transform: uppercase;
  }

  .built-birdie-route-map__card strong {
    display: block;
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.05;
    margin-block-end: 10px;
  }

  .built-birdie-route-map__card p {
    color: var(--bbr-muted);
    line-height: 1.5;
    margin-block-end: 0;
  }

  @media screen and (max-width: 989px) {
    .built-birdie-route-map__head,
    .built-birdie-route-map__grid {
      grid-template-columns: 1fr 1fr;
    }

    .built-birdie-route-map__matrix {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .built-birdie-route-map {
      padding: 36px 16px 48px;
    }

    .built-birdie-route-map__head,
    .built-birdie-route-map__grid,
    .built-birdie-route-map__matrix {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

